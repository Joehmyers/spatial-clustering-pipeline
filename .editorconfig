# EditorConfig: https://editorconfig.org
# One indentation and line-ending convention that every editor and most agents
# honour without extra configuration.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Two trailing spaces are a Markdown line break; do not eat them.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{py,go,rs,java,kt}]
indent_size = 4
