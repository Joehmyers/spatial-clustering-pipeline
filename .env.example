# Cloudflare R2: cloud storage for this project.
#
# Bucket lifecycle is managed with wrangler (see ops/create-bucket.sh); the
# bucket defaults to the repository name. Bulk data transfer (ops/fetch-data.sh)
# and asset push (ops/push-assets.sh) use the S3-compatible API and need the
# credentials below.

# For wrangler (bucket create/manage): run `wrangler login`, or set a token:
#CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
#CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# For the S3-compatible data sync (ops/fetch-data.sh) and asset push (ops/push-assets.sh):
# Create an R2 API token at: Cloudflare dashboard -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Optional: bucket name. Defaults to the repository name.
#R2_BUCKET=your-bucket-name

# Optional: only sync this path within the bucket
#R2_PREFIX=datasets/latest

# Optional: local destination (default: ./data)
#DATA_DIR=./data

# Optional: path within the bucket where created assets are uploaded (default: assets)
#R2_ASSETS_PREFIX=assets

# Optional: local directory of created assets to push (default: ./assets)
#ASSETS_DIR=./assets
